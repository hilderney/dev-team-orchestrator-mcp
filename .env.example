# ============================================================================
# zTeam Orchestrator MCP — Local Credentials (.env)
# ============================================================================
# Copy this file to `.env` in `c:\Users\htzc\mcp-servers\dev-team-orchestrator\.env`
# NEVER put API keys inside `~/.cursor/mcp.json`.
#
# Use the SAME OpenAI-compatible Base URL + API Key that you configured in
# Cursor Settings -> Models -> OpenAI API Key / Override Base URL.
# ============================================================================

# --- Option 1: 9Router (or Cursor OpenAPI Override endpoint) ---
NINEROUTER_BASE=http://localhost:20128/v1
NINEROUTER_KEY=sk-replace-with-your-9router-key

# --- Option 2: OmniRoute (optional alternative gateway) ---
# ZTEAM_LLM_GATEWAY=omniroute
# OMNIROUTE_BASE=https://your-omniroute-host/v1
# OMNIROUTE_KEY=sk-replace-with-your-omniroute-key

# --- Option 3: OpenRouter (optional alternative gateway) ---
# ZTEAM_LLM_GATEWAY=openrouter
# OPENROUTER_BASE=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key
# OPENROUTER_APP_NAME=zTeam Orchestrator MCP

# --- Optional: Default role models when `.zteam/config.json` is not present ---
MODEL_SYSTEM_ARCHITECT=9r-code-heavy
MODEL_TECHNOLOGY_ARCHITECT=9r-code-heavy
MODEL_UI_UX_DESIGNER=9r-code-light
MODEL_SOFTWARE_ENGINEER=9r-code-heavy
MODEL_QA_ENGINEER=9r-code-light

# --- Pipeline tuning ---
MAX_QA_FIX_ROUNDS=3
MAX_TOKENS_SYSTEM_ARCHITECT=4000
MAX_TOKENS_TECHNOLOGY_ARCHITECT=4000
MAX_TOKENS_UI_UX_DESIGNER=3000
MAX_TOKENS_SOFTWARE_ENGINEER=12000
MAX_TOKENS_QA_ENGINEER=4000
