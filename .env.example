NINEROUTER_BASE=https://your-9router-host/v1
NINEROUTER_KEY=sk-your-key

# Preferred 9router models per LangGraph role
MODEL_SYSTEM_ARCHITECT=9RSA-system-architect-free
MODEL_TECHNOLOGY_ARCHITECT=9RTA-technology-architect-free
MODEL_SOFTWARE_ENGINEER=9RSE-software-engineer-free
MODEL_QA_ENGINEER=9RQA-qa-free

# Workspace for resolving projectRoot (default: process.cwd())
# WORKSPACE_ROOT=

# LangGraph recursion limit (default 120). Raise for large greenfield.
# GRAPH_RECURSION_LIMIT=120

# Max SE fix rounds after QA test failures
MAX_QA_FIX_ROUNDS=3

# Progress heartbeat while waiting on LLM / tests (ms). Default 30000.
# PROGRESS_HEARTBEAT_MS=30000

# Per-role max output tokens (ChatOpenAI maxTokens)
MAX_TOKENS_SYSTEM_ARCHITECT=1600
MAX_TOKENS_TECHNOLOGY_ARCHITECT=2500
MAX_TOKENS_SOFTWARE_ENGINEER=8000
MAX_TOKENS_QA_ENGINEER=2000
