NINEROUTER_BASE=https://your-9router-host/v1
NINEROUTER_KEY=sk-your-key

# Preferred 9router models per LangGraph role (overridden by .zteam/config.json)
MODEL_SYSTEM_ARCHITECT=9RSA-system-architect-free
MODEL_TECHNOLOGY_ARCHITECT=9RTA-technology-architect-free
MODEL_UI_UX_DESIGNER=9RSA-system-architect-free
MODEL_SOFTWARE_ENGINEER=9RSE-software-engineer-free
MODEL_QA_ENGINEER=9RQA-qa-free

# Optional fallback model when SE contract fails / high latency (P2-3)
# MODEL_SOFTWARE_ENGINEER_FALLBACK=
# MODEL_UI_UX_DESIGNER_FALLBACK=
# MODEL_FALLBACK=
# ZTEAM_LLM_FALLBACK_MS=90000

# Legacy CLI fallback only — MCP never reads this (fails closed without workspaceRoot arg).
# Do NOT leave a sticky path in mcp.json env (wrong-repo footgun: pacman-z2 / mypokecards).
# WORKSPACE_ROOT=
# Refuse runs if resolved workspace ≠ this path (P1-5)
# ZTEAM_EXPECTED_WORKSPACE=

# LangGraph recursion limit (default 120). Raise for large greenfield.
# GRAPH_RECURSION_LIMIT=120

# Max SE fix rounds after QA test failures (feature logic only)
MAX_QA_FIX_ROUNDS=3
# Max bootstrap fix rounds (install/PATH) — separate budget
# MAX_BOOTSTRAP_FIX_ROUNDS=1

# Bootstrap gate: hard | shadow | off (or ZTEAM_SKIP_BOOTSTRAP_GATE=1)
# ZTEAM_BOOTSTRAP_GATE_MODE=hard
# ZTEAM_SKIP_BOOTSTRAP_GATE=0

# Prefer write_file tool calling for SE (set 0 to disable)
# ZTEAM_WRITE_FILE_TOOL=1

# Human-in-the-loop pause on exhausted QA (Fase F)
# ZTEAM_HITL=0
# ZTEAM_HITL_WEBHOOK=

# Optional docker sandbox (Fase F)
# ZTEAM_SANDBOX=0
# ZTEAM_SANDBOX_IMAGE=node:22-bookworm

# Progress heartbeat while waiting on LLM / tests (ms). Default 30000.
# PROGRESS_HEARTBEAT_MS=30000

# Per-role max output tokens (ChatOpenAI maxTokens); overridden by .zteam/config.json
MAX_TOKENS_SYSTEM_ARCHITECT=1600
MAX_TOKENS_TECHNOLOGY_ARCHITECT=2500
MAX_TOKENS_SOFTWARE_ENGINEER=8000
MAX_TOKENS_QA_ENGINEER=2000
